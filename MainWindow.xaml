<Window x:Class="KeyToSoundNeo.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="KeyToSound Neo" Width="1280" Height="820"
        MinWidth="1000" MinHeight="700" WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" Loaded="Window_Loaded" Closing="Window_Closing"
        Deactivated="Window_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown" PreviewKeyUp="Window_PreviewKeyUp">
  <Border x:Name="WindowSurface" Background="#F5F7FA" CornerRadius="18"
          BorderBrush="#E1E6EC" BorderThickness="1" SnapsToDevicePixels="True">
    <Border.Effect>
      <DropShadowEffect BlurRadius="30" ShadowDepth="8" Opacity="0.14" Color="#1C2A3A" />
    </Border.Effect>
    <Grid>
      <Grid.RowDefinitions>
        <RowDefinition Height="64" />
        <RowDefinition Height="*" />
      </Grid.RowDefinitions>
      <Border Grid.Row="0" Background="#FFFFFF" CornerRadius="18,18,0,0"
              BorderBrush="#E9EDF2" BorderThickness="0,0,0,1"
              MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
        <Grid Margin="24,0,18,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Border Width="30" Height="30" CornerRadius="10" Background="#EEF1FF" Margin="0,0,11,0">
              <TextBlock Text="K" Foreground="#5576E8" FontSize="16" FontWeight="Bold"
                         HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <TextBlock Text="KeyToSound Neo" Foreground="#202A35" FontSize="15"
                       FontWeight="SemiBold" VerticalAlignment="Center" />
            <TextBlock Text="  ·  キーボードサウンド" Foreground="#86919C" FontSize="12"
                       VerticalAlignment="Center" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <Button x:Name="SoundToggleButton" Click="SoundToggle_Click" Padding="12,7" Margin="0,0,12,0"
                    Background="#ECF7F1" BorderBrush="#D9EFE3" Foreground="#248558">
              <StackPanel Orientation="Horizontal">
                <Ellipse x:Name="SoundStatusDot" Width="7" Height="7" Fill="#42AD79" Margin="0,0,8,0" />
                <TextBlock x:Name="SoundStatusText" Text="サウンド ON" />
              </StackPanel>
            </Button>
            <Button Content="—" Width="36" Padding="0,6" Click="Minimize_Click"
                    Background="Transparent" BorderBrush="Transparent" Foreground="#73808C" />
            <Button Content="×" Width="36" Padding="0,5" Margin="4,0,0,0" Click="Close_Click"
                    Background="Transparent" BorderBrush="Transparent" Foreground="#73808C" FontSize="17" />
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="190" />
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="302" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0" Background="#172331" CornerRadius="0,0,0,18">
          <DockPanel Margin="14,22,14,18">
            <StackPanel DockPanel.Dock="Top">
              <TextBlock Text="メニュー" Foreground="#8290A0" FontSize="10"
                         FontWeight="SemiBold" Margin="10,4,0,13" />
              <Button x:Name="KeyboardNav" Tag="keyboard" Content="⌨   キーボード" Style="{StaticResource NavigationButton}" Foreground="#FFFFFF" Background="#283749" Click="Navigation_Click" />
              <Button x:Name="ProfilesNav" Tag="profiles" Content="◫   プロファイル" Style="{StaticResource NavigationButton}" Foreground="#BAC4D0" Click="Navigation_Click" />
              <Button x:Name="AdvancedNav" Tag="advanced" Content="⚙   詳細設定" Style="{StaticResource NavigationButton}" Foreground="#BAC4D0" Click="Navigation_Click" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom">
              <Border Height="1" Background="#2A3847" Margin="8,0,8,15" />
              <TextBlock Text="現在のプロファイル" Foreground="#8290A0" FontSize="10" Margin="10,0,0,6" />
              <TextBlock x:Name="SidebarProfileName" Text="Neo Base" Foreground="#E8EDF4"
                         FontSize="12" FontWeight="SemiBold" Margin="10,0,0,2" TextTrimming="CharacterEllipsis" />
              <TextBlock x:Name="SidebarKeyCount" Text="0 キー設定済み" Foreground="#8290A0"
                         FontSize="10" Margin="10,0,0,0" />
            </StackPanel>
          </DockPanel>
        </Border>
        <ScrollViewer Grid.Column="1" x:Name="MainContentScroll" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled" Padding="28,25,24,28">
          <StackPanel x:Name="MainContent" />
        </ScrollViewer>
        <Border Grid.Column="2" Background="#FFFFFF" BorderBrush="#E8ECF1"
                BorderThickness="1,0,0,0" CornerRadius="0,0,18,0">
          <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel x:Name="SettingsContent" Margin="20,24,20,24" />
          </ScrollViewer>
        </Border>
      </Grid>
    </Grid>
  </Border>
</Window>
